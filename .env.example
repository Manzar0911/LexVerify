# Application
NODE_ENV=production
PORT=3001
ALLOWED_ORIGINS=http://assessment.creativeinfozone.com,https://assessment.creativeinfozone.com,http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vendor_verification
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=true

# AI Document Extraction (Multi-modal Vision + OCR)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCorporates Company Verification
OPENCORPORATES_API_KEY=your_opencorporates_key_here

# Email Notification Service (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
