# Application
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendor_verification
DB_USER=postgres
DB_PASSWORD=postgres

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here

# Company Verification
OPENCORPORATES_API_KEY=your-opencorporates-key-here

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-key-here
EMAIL_FROM=noreply@vendorverify.com

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# JWT (for future auth)
JWT_SECRET=change-me-to-a-long-random-string-in-production
